{
	admin off
}

{$SOVA_ADDRESS:http://localhost} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /api/* {
		reverse_proxy sova-api:8080
	}

	handle /webhooks/* {
		reverse_proxy sova-api:8080
	}

	handle /media/* {
		reverse_proxy sova-api:8080
	}

	handle /health* {
		reverse_proxy sova-api:8080
	}

	handle {
		reverse_proxy sova-web:3000
	}
}
