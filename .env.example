# PostgreSQL (replace the password outside local development)
DATABASE_NAME=sova
DATABASE_USER=sova
DATABASE_PASSWORD=change-me

# Public listener. Use 80/443 on the KVM.
SOVA_HTTP_PORT=8080
SOVA_HTTPS_PORT=8443

# Caddy site address. Example for automatic HTTPS: sova.example.com
SOVA_ADDRESS=http://localhost

# Twilio (replace every value before connecting the real webhook)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=change-me
TWILIO_WHATSAPP_SENDER=whatsapp:+15550000000

# Initial private household provisioning
SOVA_HOUSEHOLD_NAME=Sova Household
SOVA_USER_A_NAME=User A
SOVA_USER_A_WHATSAPP=whatsapp:+15550000001
SOVA_USER_B_NAME=User B
SOVA_USER_B_WHATSAPP=whatsapp:+15550000002

# AI provider. AI_PROVIDER takes precedence; SOVA_AI_PROVIDER remains only as
# a temporary compatibility fallback during the Gemini rollout.
AI_PROVIDER=gemini
SOVA_AI_PROVIDER=groq

# Gemini on Google Cloud / Agent Platform. Authentication uses ADC; never put
# the service-account JSON content in this file.
GOOGLE_CLOUD_PROJECT=sova-506801
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_service_account
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_TOOL_ITERATIONS=5

# Temporary Groq rollback provider
GROQ_API_KEY=change-me
GROQ_MODEL=openai/gpt-oss-120b

# Cash-flow projection horizon
SOVA_MAX_PROJECTION_MONTHS=24

# GitHub Actions deploy reference only. Keep these lines commented: they belong
# in GitHub -> Settings -> Secrets and variables -> Actions, not in the generated
# VPS .env. All uncommented application values above must also be repository
# secrets; the workflow renders them into /opt/sova/shared/.env.
#
# Required repository secrets:
# VPS_SSH_PRIVATE_KEY=<complete OpenSSH private key, including BEGIN/END lines>
# VPS_SSH_KNOWN_HOSTS=<public-ip> ssh-ed25519 <SSH host public key>
# VPS_HOST=<public-ip>
# VPS_USER=deploy
#
# Optional repository secrets (workflow defaults shown):
# VPS_PORT=22
# VPS_DEPLOY_PATH=/opt/sova
#
# Optional repository variable (workflow default shown):
# AI_PROVIDER=gemini
# GOOGLE_CLOUD_PROJECT=sova-506801
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.5-flash-lite
# MAX_TOOL_ITERATIONS=5
# SOVA_MAX_PROJECTION_MONTHS=24
